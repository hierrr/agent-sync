{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "autoDreamEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/agent-sync/claude/hooks/ensure-automemory.sh\"",
            "timeout": 15,
            "statusMessage": "auto-memory 경로 확인"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/agent-sync/setup/git-align.sh\"",
            "timeout": 60,
            "async": true,
            "statusMessage": "git 정렬 확인"
          }
        ]
      }
    ]
  }
}
