<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.palusomni.agentsync.git-align</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/agent-sync/setup/git-align.sh</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>__HOME__/agent-sync/.last-pull</string>
    </array>
    <key>StandardOutPath</key>
    <string>__HOME__/agent-sync/setup/logs/git-align.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/agent-sync/setup/logs/git-align.log</string>
</dict>
</plist>
